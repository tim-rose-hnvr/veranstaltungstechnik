  "annotations": [
    {
      "id": "leitsatz",
      "page": "saal",
      "x": 0,
      "y": -230,
      "w": 620,
      "text": "Der Platz trägt die Identität, nicht das Gerät. Deshalb steht auf jedem Schirm zuerst der Platz — Nummer, Name, Rolle —, und erst danach, was er gerade tun darf."
    },
    {
      "id": "grenze",
      "page": "saal",
      "x": 2548,
      "y": -230,
      "w": 620,
      "text": "Während einer Abstimmung tritt alles zurück: ein Vollbild, drei Flächen, kein anderer Weg. Die Zählung bleibt bis zum Auszählen verborgen — ein Zwischenstand würde die ausstehenden Stimmen beeinflussen."
    },
    {
      "id": "webton",
      "page": "web",
      "x": 0,
      "y": -230,
      "w": 620,
      "text": "Dunkel wie ein Regieplatz, ein einziger Akzent: das Tally-Rot der offenen Kamera. Der Saalplan im Kopf ist kein Schmuck — er zeigt das Produkt in einem Bild."
    }
  ],
